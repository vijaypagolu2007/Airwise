{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "tools/**/*.js",
    "src/lib/**/*.js",
    "api/**/*.js"
  ]
}
