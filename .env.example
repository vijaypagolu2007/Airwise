# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (free tier works with flash models)
GEMINI_MODEL=gemini-3.5-flash-lite
# Used once when the main model is overloaded or rate-limited
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: share rate limits and the advice cache across Vercel instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile bot check on /api/advise and /api/chat (both keys, or neither)
# Secret key: server only. Site key: baked into the browser bundle at build time.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
